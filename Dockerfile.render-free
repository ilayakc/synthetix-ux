# Zero-cost Render demo image.
#
# The public web service runs the static frontend, FastAPI backend and ARQ
# worker in one free instance. This is intentionally a presentation/demo
# topology, not the production topology in compose.prod.yaml.

FROM node:20-alpine AS frontend-build

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_LOG_LEVEL="INFO"
ENV VITE_LOG_LEVEL=$VITE_LOG_LEVEL
ARG VITE_SLOW_REQUEST_THRESHOLD_MS="1000"
ENV VITE_SLOW_REQUEST_THRESHOLD_MS=$VITE_SLOW_REQUEST_THRESHOLD_MS

RUN npm run build

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=10000

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libgl1 libglib2.0-0 nginx \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY backend/ ./
COPY --from=frontend-build /frontend/dist /usr/share/nginx/html
COPY deploy/nginx.render-free.conf /etc/nginx/conf.d/default.conf
COPY deploy/render_free_start.py /opt/synthetix/render_free_start.py

EXPOSE 10000
STOPSIGNAL SIGTERM

CMD ["python", "/opt/synthetix/render_free_start.py"]
