# Bu dosyayı .env olarak kopyalayip gerekirse degerleri kendi ortamıniza gore duzenleyin.
# .env dosyasi git'e eklenmez (bkz. .gitignore). Buradaki degerler yalnizca yerel gelistirme icindir.
#
# ONEMLI: Bu dosyadaki JWT_SECRET_KEY / POSTGRES_PASSWORD / ANALYZER_SHARED_TOKEN
# degerleri BILINCLI OLARAK guvensizdir ve yalnizca yerel gelistirme icindir.
# `ENVIRONMENT=production` oldugunda uygulama (bkz. app/config_security.py)
# bu degerlerle veya baska bilinen placeholder'larla baslamayi REDDEDER.
# Production icin bkz. .env.production.example.

# --- PostgreSQL ---
POSTGRES_USER=synthetix
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=synthetix_ux
POSTGRES_PORT=5432
POSTGRES_HOST=db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Backend ---
# db/redis servis adlariyla (compose network) olusturulmus baglanti dizeleri
DATABASE_URL=postgresql+asyncpg://synthetix:devpassword@db:5432/synthetix_ux
BACKEND_PORT=8000
ENVIRONMENT=development

# --- Loglama (bkz. docs/production.md#5-log-kontrolu, app.logging_config) ---
# LOG_LEVEL: DEBUG/INFO/WARNING/ERROR/CRITICAL.
LOG_LEVEL=INFO
# LOG_FORMAT bos birakilirsa ENVIRONMENT'a gore otomatik secilir (production
# -> json, aksi halde pretty); acikca "json" veya "pretty" ile gecersiz kilinabilir.
LOG_FORMAT=pretty
# Bu esigi (milisaniye) asan istek/is fonksiyonu sureleri WARNING seviyesinde loglanir.
SLOW_REQUEST_THRESHOLD_MS=1000
# Istek loglama middleware'inin atlayacagi, virgulle ayrilmis yol listesi.
LOG_EXCLUDE_PATHS=/api/health

# --- Kimlik dogrulama / oturum ---
# Uretimde MUTLAKA rastgele, uzun ve gizli bir degerle degistirilmelidir
# (ornegin: python -c "import secrets; print(secrets.token_urlsafe(64))").
JWT_SECRET_KEY=dev-insecure-secret-key-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Bos birakilirsa environment'a gore otomatik belirlenir (development
# disinda True). Yerel http gelistirmede False, gercek bir uretim/staging
# ortaminda (https) True olmalidir.
COOKIE_SECURE=
COOKIE_DOMAIN=
# Yalnizca bu origin'e CORS izni verilir; frontend'in gercekte calistigi
# adresle birebir eslesmelidir.
CORS_ALLOWED_ORIGIN=http://localhost:5173
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
# Tarayici konsoluna yazilan minimum log seviyesi (bkz. frontend/src/lib/logger.ts).
VITE_LOG_LEVEL=INFO
# Bu esigi (milisaniye) asan frontend API istekleri konsolda WARNING olarak isaretlenir.
VITE_SLOW_REQUEST_THRESHOLD_MS=1000

# --- URL analiz servisi (analyzer) ---
# analyzer, ayri bir container'da calisan, Playwright/Chromium tabanli,
# SSRF'e karsi korumali, pasif bir sayfa analiz servisidir (bkz.
# docs/security.md). Host'a hicbir port yayinlamaz; yalnizca docker
# compose ag'i icinde backend/worker tarafindan cagrilir.
# ANALYZER_BASE_URL, backend/worker'in analyzer'a ulastigi ic adrestir.
ANALYZER_BASE_URL=http://analyzer:8100
# Uretimde MUTLAKA rastgele, uzun ve gizli bir degerle degistirilmelidir
# (ornegin: python -c "import secrets; print(secrets.token_urlsafe(64))").
# Bu, backend/worker disinda hic kimsenin analyzer'i dogrudan cagiramamasini
# saglayan ikinci bir savunma katmanidir (ilki: host'a port yayinlanmamasi).
ANALYZER_SHARED_TOKEN=dev-insecure-analyzer-token-change-me

# --- Yuklenen tasarim ekran goruntuleri (design assets, bkz. docs/security.md) ---
# Kullanicinin dogrudan yukledigi (URL'den degil) tasarim ekran goruntuleri.
# Yalnizca PNG/JPEG/WebP kabul edilir (SVG ve animasyonlu/cok kareli dosyalar
# HER ZAMAN reddedilir); dosya Content-Type/uzantiya bakilmaksizin gercekten
# decode edilerek dogrulanir, EXIF/metadata temizlenir ve Postgres'te
# (`design_assets.image_data`, LargeBinary) sureli olarak saklanir - bu, MVP
# icin bilincli bir karardir (bkz. docs/architecture.md); ayri bir obje
# depolama (MinIO/S3) servisi henuz yoktur.
# Yukleme (network istegi govdesi) siniri - asilir asilmaz akis durdurulur,
# dosyanin tamami belege onceden yuklenmez.
DESIGN_ASSET_MAX_BYTES=10485760
# Yeniden encode edilmis (EXIF'i temizlenmis) SAKLANAN ciktinin boyut siniri.
# Yukleme sinirindan (yukarida) KASITLI OLARAK AYRI ve biraz daha genistir:
# PNG'ler orijinal sikistirma ayarlarini korumadan yeniden encode edildiginde
# kaynaktan buyuk cikabilir; bu sinir meshru bir yuklemeyi yalnizca
# yeniden-encode fazlaligi yuzunden reddetmemek icin ayri tutulur.
DESIGN_ASSET_MAX_STORED_BYTES=20971520
# Genislik/yukseklik (piksel) ust siniri (her eksen icin ayri ayri).
DESIGN_ASSET_MAX_DIMENSION=8000
# Genislik*yukseklik (toplam piksel) ust siniri - `DESIGN_ASSET_MAX_DIMENSION`'dan
# BAGIMSIZ ek bir savunma katmanidir. Pillow'un kendi decompression-bomb
# korumasi (`Image.MAX_IMAGE_PIXELS`) bu ayardan bagimsiz olarak HER ZAMAN
# aktif kalir, devre disi birakilmaz.
DESIGN_ASSET_MAX_PIXELS=25000000
# Saklama suresi (saniye) - bu sure dolduktan sonra ikili veri (purge cron'u
# tarafindan) silinir; metadata satiri kalir. Suresi dolmus bir gorsele
# erisim, purge cron'unun bir sonraki calismasini BEKLEMEDEN preview uc
# noktasi tarafindan hemen kesilir.
DESIGN_ASSET_RETENTION_SECONDS=86400

# --- Sayfa analizi ekran goruntusu saklama (bkz. docs/security.md) ---
# URL/DOM analizi VEYA DesignAsset (screenshot/AI) kaynagindan uretilen
# `page_analyses.screenshot_data` icin varsayilan (rapora/run'a HENUZ
# baglanmamis) kisa saklama suresi (saniye). Bir DesignAsset kaynagindan
# kopyalanan snapshot, orijinal DesignAsset'ten BAGIMSIZ kendi saatini
# tasir - DesignAsset daha erken silinse/expire olsa bile bu kopya
# etkilenmez.
PAGE_ANALYSIS_SCREENSHOT_RETENTION_SECONDS=86400
# Bir PageAnalysis capture'i TAMAMLANMIS bir Report'a baglandiginda (bkz.
# app.services.page_analysis.purge_expired_screenshots), yukaridaki kisa
# sure yerine bu (daha uzun) pencere uygulanir - sure, Report'un
# OLUSTURULMA anindan itibaren islenir. SURESIZ DEGILDIR: bu sure de
# dolduktan sonra binary purge edilir; yalnizca rapor/metadata satiri kalir,
# raporun kendisi "gorsel artik mevcut degil" durumuna gecer (rapor
# ekraninda kullaniciya acikca bildirilir). Varsayilan 30 gundur - onceden
# acikca tanimlanmis bir "rapor saklama suresi" olmadigi icin bilincli,
# sinirli bir varsayilan secilmistir; degistirmek icin bu degeri guncelleyin.
REPORT_LINKED_SCREENSHOT_RETENTION_SECONDS=2592000

# --- AI destekli açıklama katmanı (bkz. docs/ai-policy.md) ---
# Gelistiricinin kendi Claude Pro/IDE aboneligi bir API anahtari SAYILMAZ.
# Varsayilan "none" hicbir anahtar olmadan deterministik sablon aciklamasi
# uretir; urun bu haliyle eksiksiz calisir. "remote" yalnizca asagidaki uc
# nokta/anahtar da doldurulmussa aktif olur.
AI_PROVIDER=none
AI_REMOTE_ENDPOINT=
AI_REMOTE_API_KEY=
AI_REMOTE_MODEL_NAME=unspecified
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=800

# --- AI ile gorsel (tasarim varyanti) uretimi (bkz. docs/ai-policy.md) ---
# Yukaridaki AI_* metin/aciklama saglayicisindan TAMAMEN AYRI bir
# yapilandirmadir. Gelistiricinin kendi Claude Pro/IDE aboneligi burada da
# bir API anahtari SAYILMAZ. Varsayilan "none" saglayicisi HICBIR gorsel
# uretmez (sahte/placeholder gorsel de uretilmez); AI ile tasarim varyanti
# secenegi yalnizca "remote" aktif VE asagidaki uc nokta/anahtar da
# doldurulmussa kullanicilara gosterilir.
IMAGE_GENERATION_PROVIDER=none
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL_NAME=unspecified
IMAGE_GENERATION_REQUEST_TIMEOUT_SECONDS=60
IMAGE_GENERATION_MAX_RETRIES=1
IMAGE_GENERATION_MAX_PROMPT_LENGTH=1000
# 'running'de takili kalmis uretim islerini kurtarma ayarlari (bkz.
# app.services.design_generation.reap_stale_running) - gorsel uretimi bir
# sayfa analizinden cok daha uzun surebilecegi icin zaman asimi payi
# kasitli olarak daha genis tutulur.
DESIGN_GENERATION_STALE_TIMEOUT_SECONDS=180
DESIGN_GENERATION_MAX_ATTEMPTS=3

# --- AI pipeline (`ai_report`) gercek provider (Faz 3D.1 / 3D.2-LOCAL) ---
# Yukaridaki AI_PROVIDER (ai_explanation icin) ile KARISTIRILMAMALIDIR - bu
# tamamen ayri bir ozelliktir. AI_REPORT_ENABLED=false (varsayilan) VE
# AI_REPORT_PROVIDER=disabled (varsayilan) oldugu surece hicbir client/network
# olusturulmaz, hicbir ucret olusmaz. AI_REPORT_PROVIDER dort degerden birini
# alir - birbirini DISLAR, otomatik fallback YOKTUR:
#   disabled -> hicbir provider yok (varsayilan, guvenli).
#   mock     -> MockAIProvider: network YOK, tamamen deterministik. Otomatik
#               pytest/regresyon testleri HER ZAMAN bunu kullanir (bkz.
#               backend/tests) - asagidaki OPENAI_*/OLLAMA_* degerleri
#               testleri ETKILEMEZ.
#   ollama   -> yerel makinede calisan (kurulumu bu dosyanin kapsami DISINDA)
#               bir Ollama daemon'ina baglanir - ucretsiz, gercek AI
#               simulasyonlari icin (bkz. OLLAMA_* asagida). API key GEREKMEZ.
#   openai   -> gercek, UCRETLI OpenAI Responses API (bkz. OPENAI_* asagida) -
#               OPENAI_API_KEY doldurulmadan hazir SAYILMAZ.
AI_REPORT_ENABLED=false
AI_REPORT_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
# arq'nun 300 saniyelik global job timeout'undan KISA olmalidir.
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=2000

# Yerel Ollama provider'i (Faz 3D.2-LOCAL / 3D.2.1) - yalnizca
# AI_REPORT_PROVIDER=ollama iken kullanilir. OLLAMA_BASE_URL varsayilan olarak
# yalnizca loopback'e (127.0.0.1/localhost/::1) izin verir; uzak bir Ollama
# sunucusu istenirse ayri, acikca belirtilmis bir OLLAMA_ALLOW_REMOTE_HOST=true
# bayragi GEREKIR (bu ornekte KASITLI olarak yer verilmez - bkz.
# backend/app/config.py). OLLAMA_TIMEOUT_SECONDS, arq job timeout'undan
# (300s, bkz. backend/app/worker_constants.py) guvenli bir marjla KUCUK
# olmalidir - config bunu ZORLAR (bkz. Settings.
# _ensure_provider_timeout_below_job_timeout).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_MAX_OUTPUT_TOKENS=2000
# "json" (varsayilan) veya "json_schema". Gercek bir yerel smoke-test (0.32.5,
# qwen3:8b) kanitladi ki `format=<json_schema>` ile gonderilen gercek pipeline
# semalari, Ollama'nin kendi grammar donusturucusu/parser'i tarafindan
# reddediliyor (HTTP 400, "failed to parse grammar") - bu yuzden "json"
# varsayilandir (bkz. backend/app/config.py Settings.ollama_structured_output_mode).
OLLAMA_STRUCTURED_OUTPUT_MODE=json

# Mock AI provider (`AI_REPORT_PROVIDER=mock`) production'da varsayilan olarak
# CALISMAZ (bkz. backend/app/config_security.py) - bu bayrak yalnizca KASITLI
# bir production dry-run/QA senaryosunda, ACIKCA true yapilarak kullanilir.
# Development/diger ortamlarda HICBIR ETKISI YOKTUR.
ALLOW_MOCK_AI_PROVIDER=false

# --- AI etkilesim isi haritasi (`ai_interaction_heatmap`) -------------------
# Yukaridaki ai_report VE ai_explanation'dan TAMAMEN AYRI, BAGIMSIZ bir Chip'li
# katalog modulu (bkz. backend/app/services/ai_interaction_heatmap). Iki kapisi
# vardir; hicbiri digerini otomatik acmaz:
#   AI_INTERACTION_HEATMAP_ENABLED  -> modulu sihirbaz katalogunda gosterir VE
#     launch'a izin verir. false (varsayilan) iken modul gizlidir, launch
#     reddedilir; hicbir ucret olusmaz.
#   AI_INTERACTION_HEATMAP_PROVIDER -> worker'in hangi secici ile calisacagi;
#     birbirini DISLAR, otomatik fallback YOKTUR:
#       disabled -> hicbir provider/network yok (varsayilan, guvenli); job'lar
#                   QUEUED kalir - deterministik cikti sessizce "AI" gibi
#                   sunulmaz.
#       mock     -> network'suz, deterministik gelistirme/test secicisi.
#                   Production'da ALLOW_MOCK_AI_PROVIDER=true ACIKCA verilmedikce
#                   ENGELLENIR (ai_report mock'uyla ayni fail-closed kural).
#       openai   -> gercek, UCRETLI OpenAI vision. Yukaridaki OPENAI_* kimlik
#                   bilgilerini YENIDEN KULLANIR - ayri bir key GEREKMEZ.
AI_INTERACTION_HEATMAP_ENABLED=false
AI_INTERACTION_HEATMAP_PROVIDER=disabled

# --- Ziyaretci / trafik analitigi (bkz. docs/security.md "Ziyaretci ve trafik ---
# analitigi", app/services/analytics.py) - yalnizca platform yoneticisi gorur. --
# KVKK acisindan olculu, gizlilik dostu: HAM IP / tam user-agent / token /
# hassas query saklanmaz, fingerprinting yapilmaz. Anonim ziyaretci sunucunun
# urettigi rastgele bir first-party visitor cerezi ile temsil edilir.
#   ANALYTICS_ENABLED -> ana anahtar. false iken hicbir olay kaydedilmez, public
#     ingestion ucu no-op (204) doner, hicbir analitik cerez set edilmez.
#     Sistemi TAMAMEN kapatmak icin bunu false yapmak yeterlidir.
#   ANALYTICS_REQUIRE_CONSENT -> true (gizlilik-oncelikli varsayilan) iken
#     pazarlama analitigi (page_view / visitor cerezi / edinim kaynagi) YALNIZCA
#     istemci acikca izin (consent) verdiginde islenir. Izin yoksa yalnizca
#     sistemin calismasi icin gerekli sunucu-tarafli is olaylari (signup/login/
#     organizasyon) pazarlama attribution'i OLMADAN tutulur.
#   ANALYTICS_RETENTION_DAYS -> analitik satirlarinin saklama suresi (gun); asan
#     kayitlar guvenli cleanup cron'uyla silinir.
#   ANALYTICS_COOKIE_TTL_DAYS -> HttpOnly `analytics_vid` (visitor) cerezinin omru.
#   ANALYTICS_COUNTRY_HEADER -> ulke tespiti icin GUVENILEN reverse-proxy header'i
#     (ornegin CF-IPCountry). Bos (varsayilan) iken ulke alani her zaman bos kalir;
#     IP'den ulke tespiti icin yeni bir ucuncu taraf servise veri gonderilmez.
ANALYTICS_ENABLED=true
ANALYTICS_REQUIRE_CONSENT=true
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_COOKIE_TTL_DAYS=180
ANALYTICS_COUNTRY_HEADER=
ANALYTICS_INGEST_RATE_LIMIT_MAX_EVENTS=120
ANALYTICS_INGEST_RATE_LIMIT_WINDOW_SECONDS=60
