# E2E (Playwright) testleri icin izole ortam degiskenleri.
#
# `docker compose --env-file compose.e2e.env -p synthetix-ux-e2e -f compose.yaml ...`
# ile birlikte kullanilir. compose.yaml'daki her deger zaten `${VAR:-varsayilan}`
# bicimindeki degisken ikamesiyle tanimlandigi icin, ayri bir overlay YAML
# dosyasina (compose.test.yaml) gerek kalmadan yalnizca bu dosyayi vererek
# t8m portlari/DB adini/URL'leri degistirmek yeterlidir. Bu dosya sir
# icermez (bkz. .env.example ile ayni ruh) ve git'e eklenir.
#
# NOT: docker compose'un `env_file: - .env` yonergesi (backend/worker/
# frontend/analyzer servislerinde) her zaman literal `.env` dosyasini okur;
# ancak compose.yaml'daki `environment:` bloklari (asagidaki degerlerle
# ikame edilir) bu env_file degerlerinin ONUNE gecer - bu yuzden izolasyon
# icin asagidaki her degeri acikca tanimlamak yeterlidir.

POSTGRES_USER=synthetix
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=synthetix_ux_e2e
POSTGRES_PORT=5532

REDIS_PORT=6479
REDIS_URL=redis://redis:6379/0

DATABASE_URL=postgresql+asyncpg://synthetix:devpassword@db:5432/synthetix_ux_e2e
BACKEND_PORT=8100
ENVIRONMENT=development

JWT_SECRET_KEY=e2e-insecure-secret-key-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
COOKIE_SECURE=
COOKIE_DOMAIN=
# Playwright, host'ta Node.js gerektirmemek icin resmi Playwright Docker
# imajiyla calisir (bkz. scripts/verify.ps1). Frontend'e ve backend'e ic
# servis adlariyla (`frontend`/`backend`) DEGIL, Docker Desktop'in host
# gateway'ine (`host.docker.internal`) yayinlanmis portlar uzerinden erisilir
# - tipki gercek bir host tarayicisinin `localhost` uzerinden erismesi gibi.
# Bunun nedeni: `frontend` ve `backend` FARKLI Docker DNS adlaridir, yani
# tarayici acisindan FARKLI "site"lerdir; access/refresh/csrf cookie'leri
# `SameSite=Lax` oldugu icin (bkz. app/cookies.py) boyle bir site-lar-arasi
# fetch isteginde geri gonderilmez ve oturum hemen duser. `host.docker.internal`
# kullanmak, gercek tarayici davranisini (ayni site, farkli port) birebir
# yeniden urettigi icin cookie/CORS guvenlik ayarlarina hic dokunmadan bu
# sorunu ortadan kaldirir.
CORS_ALLOWED_ORIGIN=http://host.docker.internal:5273
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

FRONTEND_PORT=5273
VITE_API_BASE_URL=http://host.docker.internal:8100

ANALYZER_BASE_URL=http://analyzer:8100
ANALYZER_SHARED_TOKEN=e2e-insecure-analyzer-token-change-me
