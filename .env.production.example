# Production ortami icin ORNEK degisken sablonu.
#
# BU DOSYADAKI DEGERLER KASITLI OLARAK GECERSIZ/PLACEHOLDER'DIR ve gercek bir
# production ortaminda KULLANILAMAZ - `ENVIRONMENT=production` oldugunda
# uygulama (bkz. backend/app/config_security.py) asagidaki her REPLACE_*
# degerini/kisa degerini reddedip servis vermeyi durdurur (fail-closed).
#
# Bu dosyayi ASLA gercek secret degerleriyle doldurup commit etmeyin.
# Gercek production secret'lari repoya YAZILMAZ; yalnizca dagitim
# ortaminizin kendi secret store'unda (ornegin bir orkestrasyon aracinin
# secret/parametre deposu, bir sir yoneticisi vb.) tutulur.
#
# Guclu deger uretmek icin (yerel makinenizde, repoya YAZMADAN calistirin):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY ve ANALYZER_SHARED_TOKEN icin BIRBIRINDEN FARKLI, ayri ayri
# uretilmis degerler kullanin - ikisi ayni olamaz.

# --- PostgreSQL ---
POSTGRES_USER=synthetix
# En az 32 karakter, rastgele uretilmis, benzersiz bir parola kullanin.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
POSTGRES_DB=synthetix_ux
POSTGRES_PORT=5432
POSTGRES_HOST=db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
# POSTGRES_PASSWORD ile ayni degeri iceren, gercek production DB baglanti dizesi.
DATABASE_URL=postgresql+asyncpg://synthetix:REPLACE_WITH_GENERATED_PASSWORD@db:5432/synthetix_ux
BACKEND_PORT=8000
ENVIRONMENT=production

# --- Kimlik dogrulama / oturum ---
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` ile uretin.
# ANALYZER_SHARED_TOKEN ile AYNI OLAMAZ.
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Production'da bos birakilirsa otomatik True olur (https varsayilir); bu
# genellikle dogru secimdir, acikca degistirmeyin.
COOKIE_SECURE=
COOKIE_DOMAIN=
# Gercek production frontend origin'iniz (https ile).
CORS_ALLOWED_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

# --- Trusted host allowlist (bkz. backend/app/main.py, app/config_security.py) ---
# ZORUNLU: backend'in Host header'inda kabul edecegi gercek, bilinen host
# adlarinin virgulle ayrilmis listesi (ornegin: uygulamaniz.com,www.uygulamaniz.com).
# Bos birakma veya "*" kullanma - production baslangicinda FAIL-CLOSED
# reddedilir (bkz. app.config_security.validate_production_secrets).
ALLOWED_HOSTS=REPLACE_WITH_YOUR_HOST,REPLACE_WITH_YOUR_WWW_HOST

# --- Frontend/reverse-proxy host portu (bkz. compose.prod.yaml) ---
# Disariya acilan TEK port budur; backend/worker/analyzer/db/redis hicbir
# host portu yayinlamaz.
PROD_FRONTEND_PORT=8080

# --- URL analiz servisi (analyzer) ---
ANALYZER_BASE_URL=http://analyzer:8100
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` ile uretin.
# JWT_SECRET_KEY ile AYNI OLAMAZ.
ANALYZER_SHARED_TOKEN=REPLACE_WITH_GENERATED_TOKEN

# --- AI destekli aciklama / gorsel uretim katmanlari (bkz. docs/ai-policy.md) ---
# Varsayilan "none" hicbir dis servis/anahtar gerektirmez; production'da
# etkinlestirilecekse kendi anahtarlarinizi buraya DEGIL, dagitim
# ortaminizin secret store'una yazin.
AI_PROVIDER=none
IMAGE_GENERATION_PROVIDER=none
