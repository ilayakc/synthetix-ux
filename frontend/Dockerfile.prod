# Production build: derlenmis statik dosyalari nginx ile sunar.
#
# Dev'de kullanilan `frontend/Dockerfile` (Vite dev server + bind-mount +
# hot-reload) BU DOSYAYA DOKUNMAZ ve degismeden kalir - bu, TAMAMEN AYRI ve
# tekrarlanabilir bir production build yoludur (bkz. compose.prod.yaml).

FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Ayni-origin `/api` yaklasimi: derleme zamaninda API adresi BOS birakilir,
# boylece `frontend/src/api/client.ts` istekleri gercek bir domain'e
# hardcode edilmeden goreli `/api/...` yoluna gider (nginx bunu ayni origin
# uzerinden backend'e reverse-proxy eder, bkz. nginx.prod.conf).
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Tarayici konsolu log seviyesi/yavaslik esigi (bkz. frontend/src/lib/logger.ts).
ARG VITE_LOG_LEVEL="INFO"
ENV VITE_LOG_LEVEL=$VITE_LOG_LEVEL
ARG VITE_SLOW_REQUEST_THRESHOLD_MS="1000"
ENV VITE_SLOW_REQUEST_THRESHOLD_MS=$VITE_SLOW_REQUEST_THRESHOLD_MS

RUN npm run build

FROM nginx:1.27-alpine AS production

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
